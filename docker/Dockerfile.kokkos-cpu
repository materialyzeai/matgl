# syntax=docker/dockerfile:1
#
# MatGL (from this source tree) + LAMMPS built with KOKKOS host backends
# (OpenMP + Serial) and the native `pair_style matgl` / `matgl/kk` from lammps/.
# CPU only, linux/amd64. For the CUDA build, see Dockerfile.kokkos.
#
# LAMMPS is a shared library (liblammps.so) with the `lammps` Python module
# installed, so it can be driven in-process from Python (e.g. matcalc's
# MATCALC_BACKEND=LAMMPS) as well as through `lmp`. It links the libtorch of
# the pip torch wheel: Python and LAMMPS then share one libtorch in the same
# process, and `lmp` loads TorchScript models exported by the same torch.
#
# Build from the repository root. The build context has no .git, so the version
# must be passed explicitly:
#   docker build -f docker/Dockerfile.kokkos-cpu \
#       --build-arg MATGL_VERSION="$(uvx --from setuptools-scm python -m setuptools_scm)" \
#       -t materialyzeai/matgl:latest-kokkos-cpu .
#
# Published by .github/workflows/docker.yml on every release.
#
# Run (single rank; pair_matgl does not support multi-rank domain decomposition):
#   mgl create-lammps-model -m materialyze/TensorNet-MatPES-r2SCAN -o model.pt --dtype float32
#   lmp -k on t 8 -sf kk -pk kokkos newton on neigh half -in in.lammps   # Kokkos/OpenMP
#   lmp -in in.lammps                                                    # plain pair_style matgl
#   python -c "from lammps import lammps; lammps(cmdargs=['-k', 'on', 't', '8', '-sf', 'kk'])"
#
# Derived images (e.g. materialyzeai/matml:latest-kokkos-cpu) must keep torch at
# the version LAMMPS was built against:
#   uv pip install --system -c /opt/lammps/torch-constraint.txt <packages>

########################################################################
# matgl wheel
########################################################################
FROM ghcr.io/astral-sh/uv:python3.12-bookworm-slim AS wheel

ARG MATGL_VERSION

RUN --mount=type=bind,source=.,target=/tmp/matgl,rw \
    test -n "${MATGL_VERSION}" || { echo "MATGL_VERSION build-arg is required" >&2; exit 1; }; \
    SETUPTOOLS_SCM_PRETEND_VERSION="${MATGL_VERSION}" uv build --wheel --out-dir /opt/dist /tmp/matgl

########################################################################
# Builder
########################################################################
# Same Python and site-packages layout as the runtime image, plus compilers.
FROM ghcr.io/astral-sh/uv:python3.12-bookworm AS builder

# LAMMPS release verified with lammps/ (see .github/workflows/lammps-build.yml).
ARG LAMMPS_VERSION=stable_22Jul2025_update5
ARG CMAKE_VERSION=3.31.6
ARG BUILD_JOBS=4

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update -y && apt-get install -y --no-install-recommends \
        libfftw3-dev \
        libjpeg-dev \
        libpng-dev \
        ninja-build \
        pkg-config \
    && rm -rf /var/lib/apt/lists/*

# LAMMPS requires a newer CMake than Debian ships.
RUN curl -fsSL "https://github.com/Kitware/CMake/releases/download/v${CMAKE_VERSION}/cmake-${CMAKE_VERSION}-linux-$(uname -m).tar.gz" \
        | tar -xz -C /usr/local --strip-components=1

RUN git clone --depth 1 --branch "${LAMMPS_VERSION}" https://github.com/lammps/lammps.git /opt/lammps-src

# The torch wheel provides the libtorch that LAMMPS builds against. Its exact
# version is recorded so that the runtime image installs the same one.
RUN --mount=type=bind,from=wheel,source=/opt/dist,target=/tmp/dist \
    mkdir -p /opt/lammps \
    && UV_TORCH_BACKEND=cpu uv pip install --system --no-cache /tmp/dist/matgl-*.whl \
    && uv pip freeze --system | grep -iE '^torch==' > /opt/lammps/torch-constraint.txt \
    && cat /opt/lammps/torch-constraint.txt

# pair_matgl / pair_matgl_kokkos sources from this tree.
COPY lammps /opt/matgl/lammps

# Register ML-MATGL (+ Kokkos variant) before GenerateStyleHeaders().
RUN python3 /opt/matgl/lammps/src/ML-MATGL/patch_lammps.py /opt/lammps-src /opt/matgl

# CMAKE_CXX_STANDARD=20: recent libtorch headers require C++20.
# MKL_INCLUDE_DIR: works around libtorch's Caffe2 config leaking MKL_INCLUDE_DIR-NOTFOUND.
# RPATH: lmp and liblammps.so find each other and the wheel's libtorch without LD_LIBRARY_PATH.
RUN TORCH_PREFIX="$(python3 -c 'import torch; print(torch.utils.cmake_prefix_path)')" \
    && TORCH_LIB="$(python3 -c 'import os, torch; print(os.path.join(os.path.dirname(torch.__file__), "lib"))')" \
    && cmake -B /opt/lammps-build -S /opt/lammps-src/cmake -G Ninja \
        -D CMAKE_BUILD_TYPE=Release \
        -D CMAKE_INSTALL_PREFIX=/opt/lammps \
        -D CMAKE_INSTALL_LIBDIR=lib \
        -D CMAKE_CXX_STANDARD=20 \
        -D CMAKE_PREFIX_PATH="${TORCH_PREFIX}" \
        -D CMAKE_INSTALL_RPATH="/opt/lammps/lib;${TORCH_LIB}" \
        -D MKL_INCLUDE_DIR=/usr/include \
        -D BUILD_MPI=OFF \
        -D BUILD_OMP=ON \
        -D BUILD_SHARED_LIBS=ON \
        -D PKG_KOKKOS=ON \
        -D Kokkos_ENABLE_SERIAL=ON \
        -D Kokkos_ENABLE_OPENMP=ON \
        -D PKG_ML-MATGL=ON \
        -D MATGL_PYTHON_EXECUTABLE=/usr/local/bin/python3 \
        -D PKG_ML-SNAP=ON \
        -D PKG_MANYBODY=ON \
        -D PKG_MOLECULE=ON \
        -D PKG_EXTRA-COMPUTE=ON \
        -D PKG_EXTRA-DUMP=ON \
        -D PKG_EXTRA-FIX=ON \
    && cmake --build /opt/lammps-build -j "${BUILD_JOBS}" \
    && cmake --install /opt/lammps-build

########################################################################
# Runtime
########################################################################
FROM ghcr.io/astral-sh/uv:python3.12-bookworm-slim

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update -y && apt-get install -y --no-install-recommends \
        libfftw3-double3 \
        libgomp1 \
        libjpeg62-turbo \
        libpng16-16 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /opt/lammps /opt/lammps
# pair_matgl shells out to export_matgl_checkpoint.py (path baked in at build time)
# when pair_coeff is given a raw matgl checkpoint directory.
COPY --from=builder /opt/matgl/lammps /opt/matgl/lammps
COPY --from=builder /opt/lammps-src/python/lammps /usr/local/lib/python3.12/site-packages/lammps

# CPU-only torch wheel keeps the image small; pinned to the torch LAMMPS was built against.
RUN --mount=type=bind,from=wheel,source=/opt/dist,target=/tmp/dist \
    UV_TORCH_BACKEND=cpu uv pip install --system --no-cache -c /opt/lammps/torch-constraint.txt /tmp/dist/matgl-*.whl \
    && echo /opt/lammps/lib > /etc/ld.so.conf.d/lammps.conf \
    && ldconfig

ENV PATH="/opt/lammps/bin:${PATH}" \
    MATGL_PYTHON=/usr/local/bin/python3 \
    OMP_PROC_BIND=spread \
    OMP_PLACES=threads

WORKDIR /work
