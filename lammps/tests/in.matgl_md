# in.matgl_md
#
# Short NVE run on a 2x2x2 supercell (32 atoms) of the Mo-S fixture in
# in.matgl_si. Exercises force accumulation over many steps and neighbor
# list rebuilds, so a plain pair_matgl run and a Kokkos (`-sf kk`) run can be
# compared step by step, and total-energy drift checked.
#
# Usage:
#   <lammps>/build/lmp -in in.matgl_md
#   <lammps>/build/lmp -k on t 2 -sf kk -pk kokkos neigh half newton on -in in.matgl_md
#
# Requires ./model.pt (see in.matgl_si).

units           metal
atom_style      atomic
boundary        p p p

atom_modify     map yes
newton          on

lattice         custom 1.0 a1 4.5 0.0 0.0 a2 0.0 4.5 0.0 a3 0.0 0.0 4.5 &
                origin 0 0 0 &
                basis 0.00 0.00 0.00 &
                basis 0.50 0.50 0.50 &
                basis 0.50 0.00 0.25 &
                basis 0.00 0.50 0.75
region          box prism 0 2 0 2 0 2 0 0 0 units lattice
create_box      2 box
create_atoms    1 box basis 1 1 basis 2 2 basis 3 1 basis 4 2

mass            1 95.95
mass            2 32.06

pair_style      matgl
pair_coeff      * * model.pt Mo S

variable        nsteps index 50

# `loop geom` makes the velocities independent of atom ordering and of the
# accelerator package, so plain and Kokkos runs start from the same state.
velocity        all create 300.0 4928459 dist gaussian mom yes rot yes loop geom
timestep        0.001
fix             integrate all nve
neighbor        0.5 bin
neigh_modify    every 1 delay 0 check yes

thermo_style    custom step pe ke etotal press
thermo_modify   format float %.15g
thermo          5

run             ${nsteps}
